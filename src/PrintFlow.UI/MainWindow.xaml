<Window x:Class="PrintFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintFlow - POC" Height="750" Width="500">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <Button x:Name="RefreshButton" Content="اكتشاف البرنترات" Height="35" Click="RefreshButton_Click"/>
        <ListBox x:Name="PrintersListBox" Height="150" Margin="0,10,0,10" SelectionMode="Multiple"/>
        <Button x:Name="SelectForJobButton" Content="تحديد للـ Job" Height="35" Margin="0,0,0,10" Click="SelectForJobButton_Click"/>

        <!-- تحميل ودمج الملفات -->
        <Button x:Name="LoadFilesButton" Content="تحميل ملفات PDF" Height="35" Margin="0,10,0,0" Click="LoadFilesButton_Click"/>
        <ListBox x:Name="LoadedFilesListBox" Height="80" Margin="0,10,0,0"/>
        <TextBox x:Name="WatermarkTextBox" Height="30" Margin="0,10,0,0"/>
        <Button x:Name="MergeButton" Content="دمج الملفات" Height="35" Margin="0,10,0,0" Click="MergeButton_Click"/>

        <!-- إعدادات الطباعة الموحّدة -->
        <ComboBox x:Name="PaperSizeComboBox" Height="30" Margin="0,10,0,0" SelectedIndex="0">
            <ComboBoxItem Content="A4"/>
            <ComboBoxItem Content="A3"/>
            <ComboBoxItem Content="Letter"/>
            <ComboBoxItem Content="Legal"/>
        </ComboBox>
        <TextBox x:Name="CopiesPerPrinterTextBox" Height="30" Margin="0,10,0,0" Text="1"/>
        <Button x:Name="PrintToAllButton" Content="طباعة على كل البرنترات المحددة" Height="35" Margin="0,10,0,10" Click="PrintToAllButton_Click"/>

        <TextBox x:Name="TotalCopiesTextBox" Height="30" Margin="0,10,0,0" Text="4"/>
        <Button x:Name="DistributeButton" Content="توزيع وطباعة فعلية" Height="35" Margin="0,10,0,0" Click="DistributeButton_Click"/>
        <Button x:Name="PrintTestButton" Content="طباعة صفحة اختبار للبرنتر المختارة" Height="35" Click="PrintTestButton_Click"/>
        <Button x:Name="CapabilitiesButton" Content="عرض قدرات البرنتر المختارة" Height="35" Margin="0,10,0,0" Click="CapabilitiesButton_Click"/>
        <TextBlock x:Name="ResultText" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="Bold"/>
    </StackPanel>
    </ScrollViewer>
</Window>