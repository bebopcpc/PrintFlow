<Window x:Class="PrintFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrintFlow.UI"
        Title="{Binding WindowTitle}" Height="700" Width="1080"
        FontFamily="Segoe UI" Background="#F5F6FA"
        FlowDirection="RightToLeft">

    <!--
        كل حاجة هنا مربوطة بالـ ViewModel بالـ Binding.
        مفيش x:Name لأي كنترول بيتقرا من الـ code-behind — الإعدادات عايشة في
        PrintSettings و AppSettings، والواجهة بتعكسها بس.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#DCE0E8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A93A6"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:PercentToOpacityConverter x:Key="PercentToOpacity"/>
        <local:NegateConverter x:Key="Negate"/>
        <local:ContentPositionToAlignmentConverter x:Key="PositionToAlign"/>
        <local:WarningBrushConverter x:Key="WarningBrush"/>
                <local:LogLineBrushConverter x:Key="LogLineBrush"/>
        <local:LogLineWeightConverter x:Key="LogLineWeight"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- زرار شيل الملف: دايرة حمرا فاتحة واضحة، بتغمق لما الماوس يعدي عليها.
             النسخة القديمة كانت Transparent فمحدش كان واخد باله إنها موجودة. -->
        <Style x:Key="RowDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FDECEA" CornerRadius="12"
                                BorderBrush="#F1B0AA" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0483E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E0483E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">

            <!-- ══════════════════ تاب الرئيسية ══════════════════ -->
            <TabItem Header="الرئيسية">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" IsEnabled="{Binding IsIdle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <StackPanel>
                                <GroupBox Header="خيارات دمج ومعالجة الملفات">
                                    <StackPanel>
                                        <CheckBox Content="ترقيم صفحات كل ملف"
                                                  IsChecked="{Binding Settings.NumberPagesPerFile}"/>
                                        <CheckBox Content="دمج وحفظ الملفات"
                                                  IsChecked="{Binding Settings.MergeFiles}"
                                                  ToolTip="مفتوحة = كل الملفات تبقى مستند واحد.&#10;مقفولة = كل ملف يفضل لوحده، والعلامة المائية والترقيم بيتحطوا على كل واحد فيهم."/>
                                        <CheckBox Content="حفظ الملفات المحوّلة لـ PDF"
                                                  IsChecked="{Binding Settings.SaveConvertedToPdf}"
                                                  ToolTip="الصور بتتحوّل لـ PDF أول ما تتحمّل.&#10;مفتوحة = النسخة المحوّلة بتتحفظ في المجلد الافتراضي.&#10;مقفولة = بتروح للتيمب وبتتمسح بعد أيام."/>
                                        <CheckBox Content="حفظ الملفات بعد المعالجة"
                                                  IsChecked="{Binding Settings.SaveAfterProcessing}"
                                                  ToolTip="بيحفظ الملفات المعالجة في &quot;المجلد الافتراضي&quot; من تاب الإعدادات العامة بدل التيمب.&#10;من غيرها الملفات بتتمسح بعد أيام."/>

                                        <TextBlock Text="ضغط الملفات (قريبًا)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding CompressionModes}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.Compression}"
                                                  IsEnabled="False"
                                                  ToolTip="اتقاس فعليًا: إعادة حفظ الـ PDF بتوفّر صفر تقريبًا — الملفات أصلًا مضغوطة.&#10;التوفير الحقيقي بيجي من تصغير دقة الصور جوه المستند (٤٥-٧٠٪ على المستندات الممسوحة)،&#10;وده محتاج أداة خارجية. مقفول لحد ما يتبني صح بدل ما يبان شغال وهو مش بيعمل حاجة."/>

                                        <CheckBox Content="حذف صفحات من كل ملف"
                                                  IsChecked="{Binding Settings.DeletePages}"
                                                  ToolTip="الأرقام بتتحسب لكل ملف لوحده.&#10;يعني &quot;1&quot; بتشيل أول صفحة من كل ملف محمّل، مش أول صفحة في المستند المدموج."/>
                                        <TextBox Text="{Binding Settings.PagesToDelete, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,0"
                                                 IsEnabled="{Binding Settings.DeletePages}"
                                                 ToolTip="مثال: 1,3,5-8&#10;بيقبل الأرقام العربية والإنجليزية، والفاصلة العربية."/>
                                        <TextBlock Text="{Binding PagesToDeleteSummary}" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding Settings.DeletePages,
                                                                Converter={StaticResource BoolToVis}}"/>

                                        <TextBlock Text="العنصر الرمادي (الضغط) لسه مقفول — شوف الشرح عليه" FontSize="10"
                                                   Foreground="#AAA" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="خيارات الشرائح">
                                    <StackPanel>
                                        <TextBlock Text="عدد الشرائح على الورقة" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding SlidesPerSheetOptions}"
                                                  SelectedItem="{Binding Settings.SlidesPerSheet}"
                                                  ToolTip="١ = كل صفحة على ورقة لوحدها (المستند بيعدّي زي ما هو).&#10;التقسيم بيتحدد لوحده حسب شكل الورقة وشكل الصفحة."/>

                                        <TextBlock Text="اتجاه الصفحة" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding PageOrientations}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.SlideOrientation}"/>

                                        <TextBlock Text="اتجاه البدء" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding SlideStarts}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.SlideStart}"/>

                                        <TextBlock Text="ترتيب الشرائح" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding SlideOrders}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.SlideOrder}"/>

                                        <TextBlock Text="الهوامش" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Settings.SlideMargin}"/>

                                        <CheckBox Content="إضافة إطار حول الشريحة"
                                                  IsChecked="{Binding Settings.DrawSlideBorder}"/>

                                        <!-- معاينة حية: الأرقام دي بتتحسب بنفس دوال الطباعة
                                             بالظبط، فمستحيل المعاينة تختلف عن الورق الطالع -->
                                        <TextBlock Text="شكل الورقة" Style="{StaticResource FieldLabel}"/>

                                        <Border Background="#F0F2F7" CornerRadius="5" Padding="10"
                                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                            <StackPanel>
                                                <Border Background="White" BorderBrush="#B9C0CE" BorderThickness="1"
                                                        Width="{Binding SlidePreviewWidth}"
                                                        Height="{Binding SlidePreviewHeight}"
                                                        HorizontalAlignment="Center"
                                                        FlowDirection="LeftToRight">
                                                    <ItemsControl ItemsSource="{Binding SlidePreview}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                        Background="#DCE6F8" BorderBrush="#8FA9D6"
                                                                        BorderThickness="1" CornerRadius="1">
                                                                    <TextBlock Text="{Binding Number}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="Bold" FontSize="12"
                                                                               Foreground="#2B4A80"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <TextBlock Text="{Binding SlideLayoutSummary}"
                                                           HorizontalAlignment="Center" Margin="0,8,0,0"
                                                           FontSize="11" Foreground="#556"
                                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <StackPanel>
                                <GroupBox Header="خيارات البوكليت (Booklet)">
                                    <StackPanel>
                                        <CheckBox Content="طباعة الملفات بنظام بوكليت"
                                                  IsChecked="{Binding Settings.BookletMode}"
                                                  ToolTip="صفحتين على كل وجه بترتيب مخصوص.&#10;اطبع على الوجهين واطوي من النص — الكتيّب هيطلع مرتب.&#10;بيتجاهل عدد الشرائح واتجاه الورقة."/>

                                        <TextBlock Text="اتجاه البدء" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding BookletStarts}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.BookletStart}"
                                                  IsEnabled="{Binding Settings.BookletMode}"
                                                  ToolTip="يمين = كتيّب عربي (الغلاف على اليمين).&#10;يسار = كتيّب إنجليزي."/>

                                        <TextBlock Text="{Binding BookletSummary}" Margin="0,8,0,0"
                                                   FontSize="11" Foreground="#556" TextWrapping="Wrap"
                                                   Visibility="{Binding Settings.BookletMode,
                                                                Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="خيارات الطباعة">
                                    <StackPanel>
                                        <CheckBox Content="الطباعة مباشرة بعد المعالجة"
                                                  IsChecked="{Binding Settings.PrintDirectlyAfterProcessing}"/>
                                        <CheckBox Content="طباعة أبيض وأسود (Grayscale)"
                                                  IsChecked="{Binding Settings.Grayscale}"/>
                                        <CheckBox Content="الطباعة على الوجهين (Duplex)"
                                                  IsChecked="{Binding Settings.Duplex}"/>

                                        <TextBlock Text="اتجاه قلب الصفحة" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding DuplexFlips}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.DuplexFlip}"
                                                  IsEnabled="{Binding Settings.Duplex}"/>

                                        <!-- ═══ قايمة المكن ═══

                                             كان هنا قايمة منسدلة (طابعة واحدة بس)، ومربع في آخر
                                             القايمة بيفتح "وضع أكتر من طابعة"، وده بيخبّي قايمة
                                             تعليم **في عمود تاني خالص**، ومربع تالت للتوزيع.
                                             قرار واحد متقسّم على تلات أماكن.

                                             جه بلاغ بالنص: "مش عارف اختار أكتر من واحدة" — من
                                             مستخدم عنده سبع طابعات والميزة شغالة قدامه.

                                             دلوقتي حاجة واحدة في مكان واحد: علّم على اللي عايزه.
                                             واحدة = اطبع عليها، أكتر = وزّع عليهم. -->
                                        <TextBlock Text="الطابعات (علّم على اللي هيتطبع عليها)"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <Border BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4"
                                                Padding="2" Margin="0,2,0,0">
                                                                                        <!--
                                                الاسم الطويل كان بيتقص.

                                                السبب مش العرض: الـ ListBoxItem
                                                بياخد عرض محتواه مش عرض اللستة،
                                                فالـ Wrap مالقاش حدود يلفّ عندها.
                                                Stretch بيدي الصف عرض اللستة،
                                                وساعتها اللفّ بيشتغل.

                                                والنص اتشال من Content لجوّه
                                                CheckBox عشان TextWrapping —
                                                الـ Content النصي مابيلفّش.
                                            -->
                                            <ListBox ItemsSource="{Binding Printers}" MaxHeight="180"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  IsEnabled="{Binding IsEligible}"
                                                                  VerticalContentAlignment="Center"
                                                                  Margin="2,3"
                                                                  ToolTip="{Binding DisplayText}">
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       TextWrapping="Wrap" LineHeight="17"/>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <Button Content="تحديث الطابعات" Padding="8,3" FontSize="11"
                                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Background="{StaticResource AccentBrush}"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding RefreshPrintersCommand}"/>

                                        <!-- السطر ده بيقول النتيجة مش التعليمات:
                                             "٣ مكن مختارة — الشغل هيتقسّم عليهم بالصفحات: ٦٨٠ / ٦٨٠ / ٦٤٠" -->
                                        <TextBlock Text="{Binding PrinterChoiceSummary}" TextWrapping="Wrap"
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                   Foreground="{StaticResource AccentBrush}"/>

                                        <CheckBox Content="كل مكنة تطبع العدد كامل (من غير تقسيم)"
                                                  IsChecked="{Binding SameCountOnEveryPrinter}"
                                                  Margin="0,6,0,0"
                                                  ToolTip="الافتراضي إن الشغل بيتقسّم على المكن المعلّمة عشان الكل يخلص مع بعض.&#10;علّم هنا بس لو عايز كل مكنة تطلّع النسخ كاملة (نسخة لكل فرع مثلًا)."/>

                                        <TextBlock Text="اتجاه الصفحة" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding PageOrientations}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.PageOrientation}"/>

                                        <TextBlock Text="حجم الورق" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding PaperSizes}"
                                                  SelectedItem="{Binding Settings.PaperSize}"/>

                                       <TextBlock Text="مقياس الصفحة (%)" Style="{StaticResource FieldLabel}"/>
<TextBox Text="{Binding Settings.ScalePercent, UpdateSourceTrigger=PropertyChanged, Delay=500}"
         ToolTip="مقاس الورقة مابيتغيّرش — المحتوى بس هو اللي بيصغّر أو يكبر.&#10;٩٥٪ مثلًا بتبعد المحتوى عن الحواف لو الطابعة بتقص منها.&#10;من ١٠ لـ ٤٠٠."/>
                                        <TextBlock Text="{Binding ScaleSummary}" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="إجمالي عدد النسخ" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Settings.TotalCopies}"/>
                                        
                                        <!-- مدى الصفحات: بيشتغل وقت الطباعة بس، فالمستند
                                             مابيتغيّرش والترقيم بيفضل زي ما هو — على عكس
                                             "حذف الصفحات" اللي بيعيد الترقيم من ١. -->
                                        <TextBlock Text="مدى الصفحات (صفر = المستند كله)"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="من صفحة" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Text="{Binding Settings.PageFrom}"
                                                         ToolTip="أول صفحة تتطبع. صفر = من أول المستند."/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="لصفحة" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Text="{Binding Settings.PageTo}"
                                                         ToolTip="آخر صفحة تتطبع. صفر = لآخر المستند."/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- السطر ده بيفضل ظاهر طول ما المدى شغّال. المدى
                                             بيتحفظ بين التشغيلات، فمن غيره حد يظبطه وينساه
                                             وكل أوردر بعد كده يتقص من غير ما حد ياخد باله. -->
                                        <TextBlock Text="{Binding PageRangeSummary}" TextWrapping="Wrap"
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                   Foreground="{Binding PageRangeIsActive,
                                                                Converter={StaticResource WarningBrush}}"
                                                   Visibility="{Binding PageRangeIsActive,
                                                                Converter={StaticResource BoolToVis}}"/>

                                        <!-- تحذير فخّ الدمج: لو "دمج وحفظ الملفات" شغّال، الـ ٥٠
                                             ملزمة بتبقى مستند واحد والتوزيع مالوش حاجة يقسّمها
                                             غير النسخ. ده بيفضل لازم يتقال. -->
                                        <TextBlock Text="{Binding DistributionSummary}" TextWrapping="Wrap"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{Binding DistributionIsWarning,
                                                                Converter={StaticResource WarningBrush}}"
                                                   Visibility="{Binding DistributionIsWarning,
                                                                Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                    CornerRadius="8" Background="#EEF3FF" Height="90"
                                    AllowDrop="True"
                                    Drop="FileDropArea_Drop"
                                    DragOver="FileDropArea_DragOver"
                                    MouseLeftButtonUp="FileDropArea_Click">
                                <TextBlock Text="اسحب ملفات PDF أو صور هنا وأفلتها، أو اضغط لتحميل الملفات"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="10"/>
                            </Border>

                            <GroupBox Grid.Row="1" Header="{Binding FilesCountText}" Margin="0,8,0,0">
                                <ListBox ItemsSource="{Binding Files}" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="✕"
                                                        Style="{StaticResource RowDeleteButton}"
                                                        ToolTip="شيل الملف ده من القايمة"
                                                        Command="{Binding DataContext.RemoveFileCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

<!-- صندوق "اختر الطابعات" كان هنا. اتشال: مالوش لازمة بعد ما
                                 القايمة بقت جنب باقي خيارات الطباعة، ووجوده في عمود
                                 تاني كان هو نفسه المشكلة. -->
                                                             <GroupBox Grid.Row="2" Header="تقدم الأوردر" Margin="0,8,0,0"
                                      Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Progress}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{Binding Caption}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                                <!-- السطر ده كلام الطابعة نفسها مش حسابنا: بيتحدّث كل
                                                     تانيتين من طابور ويندوز، فبيتحرك مع الورق وهو طالع.
                                                     بيختفي لما الدرايفر مايقولش أرقام. -->
                                                <TextBlock Grid.Row="1" Text="{Binding QueueCaption}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,3"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Visibility="{Binding HasQueueNews,
                                                                        Converter={StaticResource BoolToVis}}"/>

                                                <ProgressBar Grid.Row="2" Height="8" Minimum="0" Maximum="100"
                                                             Value="{Binding Percent, Mode=OneWay}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="#2FA84F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E0483E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                                                        <!--
                                النتائج: سطر واحد لكل حدث، لونه بيقول نوعه.

                                كان ListBox خام: كل السطور بنفس اللون ومقصوصة من
                                الجنب، والتحذير اللي بيقول «٣ نسخة مش متأكدين
                                طلعت» كان بيعدّي في وسط عشرين سطر عادي.

                                الاختيار اتقفل عن قصد: ده تقرير بيتقرا مش لستة
                                بتتختار منها، والزرقة اللي كانت بتظهر مع الكليك
                                كانت بتخفي لون السطر نفسه.
                            -->
                            <GroupBox Grid.Row="3" Header="النتائج">
                                <ListBox x:Name="ResultsLog" Loaded="ResultsLog_Loaded"
                                         ItemsSource="{Binding Log}" BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch"
                                         VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="4"
                                                    Padding="8,5" Margin="0,0,0,3"
                                                    BorderThickness="3,0,0,0"
                                                    BorderBrush="{Binding Converter={StaticResource LogLineBrush}}">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="11.5" LineHeight="18"
                                                           Foreground="{Binding Converter={StaticResource LogLineBrush}}"
                                                           FontWeight="{Binding Converter={StaticResource LogLineWeight}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!--
                        IsEnabled على صف الزراير ده كان ناقص.
                        الـ Grid اللي فوق (Row 0) متربط بـ IsIdle، بس الزراير
                        في صف تاني خالص — يعني كانت شغّالة طول الوقت، حتى
                        والأوردر بيتبعت. ومن هنا طلع الورق مرتين في ١.٩.٧.
                        الأوامر نفسها مقفولة من جوّه كمان؛ ده القفل التاني.
                    -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                        <Button Content="تحميل الملفات" Background="#2FA84F"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                Click="LoadFilesButton_Click"/>
                        <Button Content="بدء معالجة الملفات" Background="{StaticResource AccentBrush}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                Command="{Binding ProcessCommand}"/>
                        <Button Content="طباعة الآن" Background="#1F4FB0"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                Command="{Binding PrintCommand}"/>
                        <Button Content="حذف الملفات وإرجاع الإعدادات" Background="#E0483E"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>

                        <!-- بره قفل IsIdle عن قصد: ده الزرار الوحيد اللي
                             لازم يشتغل والأوردر ماشي. -->
                        <Button Content="إيقاف فوري" Background="#B3261E" Margin="12,0,0,0"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══════════════════ تاب الإعدادات المسبقة ══════════════════ -->
            <TabItem Header="الإعدادات المسبقة">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="الإعدادات المسبقة المحفوظة" Margin="0,0,10,0">
                        <ListBox ItemsSource="{Binding Presets}"
                                 SelectedItem="{Binding SelectedPreset}"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Settings.PaperSize}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="حفظ الإعدادات الحالية" Style="{StaticResource TabTitle}"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,10"
                                   Text="اضبط الخيارات اللي إنت عايزها في تاب الرئيسية، وبعدين اكتب اسم هنا واضغط إضافة. الإعداد بيتحفظ في ملف على الجهاز وبيفضل موجود بعد ما تقفل البرنامج."/>

                        <TextBlock Text="اسم الإعداد المسبق" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300" HorizontalAlignment="Right"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="إضافة" Background="#2FA84F" Margin="0,0,8,0"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding AddPresetCommand}"/>
                            <Button Content="تعديل" Background="#E67E22" Margin="0,0,8,0"
                                    Style="{StaticResource ActionButton}"
                                    ToolTip="بيكتب الإعدادات الحالية فوق الإعداد المختار"
                                    Command="{Binding UpdatePresetCommand}"/>
                            <Button Content="حذف" Background="#E0483E" Margin="0,0,8,0"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding DeletePresetCommand}"/>
                            <Button Content="تطبيق" Background="{StaticResource AccentBrush}"
                                    Style="{StaticResource ActionButton}"
                                    ToolTip="بينقل قيم الإعداد المختار لتاب الرئيسية"
                                    Command="{Binding ApplyPresetCommand}"/>
                        </StackPanel>

                        <GroupBox Header="تفاصيل الإعداد المختار" Margin="0,20,0,0">
                            <TextBlock Text="{Binding SelectedPresetSummary}" TextWrapping="Wrap"
                                       Padding="4" Foreground="#444"/>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══════════════════ تاب الإعدادات العامة ══════════════════ -->
            <TabItem Header="الإعدادات العامة">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- عام + ترقيم -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <GroupBox Header="إعدادات عامة">
                                <StackPanel>
                                    <TextBlock Text="الطابعة الافتراضية للبرنامج (نقطة البداية)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Printers}"
                                              DisplayMemberPath="Name" SelectedValuePath="Name"
                                              SelectedValue="{Binding App.DefaultPrinterName}"
                                              ToolTip="دي اللي البرنامج بيبدأ بيها لما يفتح.&#10;الطباعة الفعلية بتروح لطابعة تاب الرئيسية — لو غيّرتها هناك، اختيارك هناك هو اللي بيحصل."/>

                                    <TextBlock Text="ترتيب الملفات" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding FileSortOrders}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding App.FileSortOrder}"/>

                                    <TextBlock Text="طريقة الحساب (قريبًا)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding CountingMethods}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding App.CountingMethod}" IsEnabled="False"
                                              ToolTip="الاختيار بيتحفظ، بس حساب التكلفة بالورقة لسه مش مبني"/>

                                    <TextBlock Text="المظهر (قريبًا)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Themes}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding App.Theme}" IsEnabled="False"
                                              ToolTip="الاختيار بيتحفظ، بس تطبيق الثيم المعتم لسه مش مبني"/>

                                    <TextBlock Text="اللغة (قريبًا)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Languages}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding App.Language}" IsEnabled="False"
                                              ToolTip="الاختيار بيتحفظ، بس الترجمة للإنجليزي لسه مش مبنية"/>

                                    <TextBlock Text="مجلد افتراضي لحفظ الملفات" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.DefaultOutputFolder}" IsReadOnly="True"
                                             ToolTip="بيشتغل مع &quot;حفظ الملفات بعد المعالجة&quot; في تاب الرئيسية.&#10;سيبه فاضي والملفات هتروح للتيمب وتتمسح بعد أيام."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="اختيار مجلد" Background="#1B2A4A" FontSize="11" Padding="8,4"
                                                Margin="0,0,6,0" Style="{StaticResource ActionButton}"
                                                Click="PickOutputFolder_Click"/>
                                        <Button Content="إزالة" Background="#E0483E" FontSize="11" Padding="8,4"
                                                Style="{StaticResource ActionButton}"
                                                Click="ClearOutputFolder_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="تحديث حالة الطابعات (ثانية)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.PrinterRefreshSeconds}"/>

                                    <TextBlock Text="مسح الملفات المؤقتة الأقدم من (يوم)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.TempFileRetentionDays}"/>

                                </StackPanel>
                            </GroupBox>
                            
                            <!--
                                صيانة. الزرار ده بيمسح طابور ويندوز كله مش
                                طابور البرنامج، فمكانه هنا مش في تاب الرئيسية.

                                مقفول لما يكون فيه شغل ماشي (IsIdle): لو
                                اتضغط والأوردر بيتبعت، اللي إحنا بعتناه هو
                                نفسه اللي هيتمسح.
                            -->
                            <GroupBox Header="صيانة">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                               Text="لو الطابعة واقفة والجوبات مكوّمة ومش بتتحرك، ده بيصلّح طابور ويندوز."/>

                                    <Button Content="تنظيف طابور الطباعة" Background="#B5651D"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Padding="10,6" FontSize="11"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding CleanSpoolerCommand}"
                                            ToolTip="بيوقف خدمة الطباعة، يمسح الجوبات الزنقانة، ويشغّلها تاني.&#10;⚠ بيمسح طابور ويندوز كله — أي شغل مستني من أي برنامج تاني هيضيع.&#10;⚠ محتاج تشغّل البرنامج كمسؤول (Run as administrator)."/>

                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#B06600"
                                               Margin="0,6,0,0"
                                               Text="⚠ بيمسح شغل كل البرامج المستني في الطابور، ومحتاج صلاحية مسؤول."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="الاستقبال من بره البرنامج">
                                <StackPanel>
                                    <CheckBox Content="استقبال من طابعة PrintFlow"
                                              IsChecked="{Binding App.ReceiveFromVirtualPrinter}"
                                              ToolTip="بيخلّي البرنامج يلقط أي حاجة تتطبع على طابعة PrintFlow من أي برنامج تاني.&#10;الطابعة نفسها بتتسطّب مرة واحدة بـ install-printer.ps1 كمسؤول."/>

                                    <TextBlock Text="مجلد مراقَب (أي ملف يتحط فيه بيتحمّل لوحده)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.HotFolder}" IsReadOnly="True"
                                             ToolTip="لو حطيته على مجلد مشارك على الشبكة، كل أجهزة المطبعة تقدر ترمي فيه."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="اختيار مجلد" Padding="8,4" FontSize="11"
                                                Click="ChooseHotFolder_Click"/>
                                        <Button Content="إزالة" Padding="8,4" FontSize="11" Margin="6,0,0,0"
                                                Click="ClearHotFolder_Click"/>
                                    </StackPanel>

                                    <CheckBox Content="طباعة الوارد تلقائيًا من غير ما أضغط"
                                              IsChecked="{Binding App.PrintReceivedAutomatically}"
                                              Margin="0,8,0,0"
                                              ToolTip="مقفولة افتراضيًا عن قصد — ورق بيطلع من غير ما حد ضغط حاجة ده سلوك مخيف في مطبعة.&#10;شغّلها بس لما تكون متأكد من الإعدادات."/>

                                    <TextBlock Text="{Binding ReceptionStatus}" TextWrapping="Wrap"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0"/>

                                    <Button Content="فتح مجلد سجل التشغيل" Background="#1B2A4A" FontSize="11"
                                            Padding="8,4" Margin="0,12,0,0" HorizontalAlignment="Right"
                                            Style="{StaticResource ActionButton}"
                                            ToolTip="فيه ملف لكل يوم بكل عمليات المعالجة والطباعة — ابعته لو حصلت مشكلة"
                                            Click="OpenLogFolder_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="إعدادات الترقيم">
                                <StackPanel>
                                    <CheckBox Content="ترقيم الورقة كاملة بدل الشريحة"
                                              IsChecked="{Binding App.NumberWholeSheetInsteadOfSlide}"
                                              ToolTip="مفتوحة = رقم واحد للورقة كلها بحجمه الطبيعي (1، 2، 3…).&#10;مقفولة = كل شريحة بترقمها الأصلي، والرقم بيصغّر مع الشريحة.&#10;بيفرق بس لما يبقى في أكتر من شريحة على الورقة."/>

                                    <CheckBox Content="كل ملف يبدأ ترقيمه من 1"
                                              Margin="0,6,0,0"
                                              IsChecked="{Binding App.RestartNumberingForEachFile}"
                                              ToolTip="مقفولة = ترقيم متصل على المستند كله (1 من 40، 2 من 40…)&#10;مفتوحة = كل ملف لوحده (1 من 5 في الملف الأول، 1 من 12 في التاني…)"/>

                                    <CheckBox Content="خلفية خفيفة ورا الرقم"
                                              Margin="0,6,0,0"
                                              IsChecked="{Binding App.PageNumberBackdrop}"
                                              ToolTip="على ورقة بيضا مش بتبان خالص.&#10;على مستند بخلفية ملونة كاملة دي اللي بتخلي الرقم يتقرا بدل ما يختفي."/>

                                    <TextBlock Text="مكان الترقيم" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ContentPositions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding App.PageNumberPosition}"/>

                                    <TextBlock Text="لون الترقيم" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ColorPalette}"
                                              SelectedValuePath="Hex"
                                              SelectedValue="{Binding App.PageNumberColorHex}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0"
                                                            BorderBrush="#CCC" BorderThickness="1"
                                                            Background="{Binding Hex, Converter={StaticResource HexToBrush}}"/>
                                                    <TextBlock Text="{Binding Label}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="حجم خط الترقيم" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.PageNumberFontSize}"/>

                                    <TextBlock Text="المسافة من الحافة" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.PageNumberEdgeMargin}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- نص مخصص + علامة مائية -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <GroupBox Header="النص المخصص">
                                <StackPanel>
                                    <CheckBox Content="إضافة نص مخصص لكل الملفات"
                                              IsChecked="{Binding App.CustomTextEnabled}"/>
                                    <TextBox Text="{Binding App.CustomText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,0" IsEnabled="{Binding App.CustomTextEnabled}"/>

                                    <TextBlock Text="مكان النص" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ContentPositions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding App.CustomTextPosition}"
                                              IsEnabled="{Binding App.CustomTextEnabled}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="العلامة المائية (Watermark)">
                                <StackPanel>
                                    <CheckBox Content="إضافة علامة مائية لكل الملفات"
                                              IsChecked="{Binding App.WatermarkEnabled}"/>
                                    <CheckBox Content="العلامة على الورقة كاملة بدل الشريحة"
                                              IsChecked="{Binding App.WatermarkOnWholeSheet}"
                                              ToolTip="مفتوحة = علامة واحدة كبيرة على الورقة كلها.&#10;مقفولة = علامة على كل شريحة لوحدها، بتصغّر معاها.&#10;بيفرق بس لما يبقى في أكتر من شريحة على الورقة."/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                IsEnabled="{Binding App.WatermarkEnabled}">
                                        <RadioButton Content="نص" GroupName="WatermarkKind" Margin="0,0,16,0"
                                                     IsChecked="{Binding App.WatermarkIsImage,
                                                                 Converter={StaticResource InverseBool}}"/>
                                        <RadioButton Content="صورة" GroupName="WatermarkKind"
                                                     IsChecked="{Binding App.WatermarkIsImage}"/>
                                    </StackPanel>

                                    <TextBlock Text="النص" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.WatermarkText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding App.WatermarkIsImage,
                                                         Converter={StaticResource InverseBool}}"/>

                                    <TextBlock Text="صورة العلامة" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding App.WatermarkImagePath}" IsReadOnly="True"/>
                                    <Button Content="اختيار صورة" Background="#1B2A4A" FontSize="11" Padding="8,4"
                                            HorizontalAlignment="Right" Margin="0,6,0,0"
                                            IsEnabled="{Binding App.WatermarkIsImage}"
                                            Style="{StaticResource ActionButton}"
                                            Click="PickWatermarkImage_Click"/>

                                    <TextBlock Text="اللون" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ColorPalette}"
                                              SelectedValuePath="Hex"
                                              SelectedValue="{Binding App.WatermarkColorHex}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0"
                                                            BorderBrush="#CCC" BorderThickness="1"
                                                            Background="{Binding Hex, Converter={StaticResource HexToBrush}}"/>
                                                    <TextBlock Text="{Binding Label}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="الخط" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding WatermarkFonts}"
                                              SelectedItem="{Binding App.WatermarkFontFamily}"/>

                                    <CheckBox Content="خط عريض (Bold)" IsChecked="{Binding App.WatermarkBold}"/>

                                    <TextBlock Text="{Binding App.WatermarkFontSize, StringFormat='حجم الخط: {0}'}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <Slider Minimum="6" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding App.WatermarkFontSize}"/>

                                    <!--
                                        كان مكتوب "الشفافية" وده عكس معنى الرقم بالظبط:
                                        Alpha = Percent × 255 ÷ 100، يعني ١٠٠ = لون صامت تمامًا
                                        مش شفاف تمامًا. اللي كان بيرفع السلايدر لآخره فاكر إنه
                                        بيفتّح العلامة، كان بيطلّعها صامتة فوق المحتوى.
                                        الرقم زي ما هو (عشان الإعدادات المحفوظة ما تتغيّرش) —
                                        الكلمة هي اللي اتصلحت.
                                    -->
                                    <TextBlock Text="{Binding App.WatermarkOpacityPercent, StringFormat='درجة الظهور: {0}%'}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding App.WatermarkOpacityPercent}"
                                            ToolTip="١٠٠٪ = العلامة صامتة تمامًا وبتغطي المحتوى.&#10;للعلامة المائية العادية ٢٥-٤٠٪ بيكون أنسب."/>

                                    <TextBlock Text="{Binding App.WatermarkRotationDegrees, StringFormat='زاوية الدوران: {0}°'}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <Slider Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding App.WatermarkRotationDegrees}"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="استعادة الإعدادات الافتراضية" Background="#E67E22"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding RestoreDefaultAppSettingsCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- معاينة -->
                    <GroupBox Grid.Column="2" Header="معاينة">
                        <!--
                            الـ Viewbox بيصغّر المعاينة كلها لو العمود ضاق، من غير ما
                            يكسر نسبة الورقة. من غيره كان لازم نسيب المقاس حر —
                            وده اللي كان بيحصل: الصندوق كان بياخد مقاس المحتوى
                            فيطلع مستطيل عرضي قصير، والمستخدم يشوف "أسفل شمال"
                            في صندوق مش شكله ورقة أصلًا.
                        -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- نسبة A4 بالظبط: 595×842 → 300×424 -->
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    Width="300" Height="424"
                                    FlowDirection="LeftToRight">
                            <Grid ClipToBounds="True">
                                <!-- خطوط تمثّل محتوى الصفحة -->
                                <StackPanel Margin="24" VerticalAlignment="Top" Opacity="0.25">
                                    <Rectangle Height="4" Fill="#999" Margin="0,0,0,9"/>
                                    <Rectangle Height="4" Fill="#999" Margin="0,0,0,9"/>
                                    <Rectangle Height="4" Fill="#999" Margin="0,0,0,9" Width="180" HorizontalAlignment="Left"/>
                                    <Rectangle Height="4" Fill="#999" Margin="0,0,0,9"/>
                                    <Rectangle Height="4" Fill="#999" Margin="0,0,0,9" Width="120" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- العلامة المائية -->
                                <TextBlock Text="{Binding App.WatermarkText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{Binding App.WatermarkFontFamily}"
                                           FontSize="{Binding App.WatermarkFontSize}"
                                           Foreground="{Binding App.WatermarkColorHex, Converter={StaticResource HexToBrush}}"
                                           Opacity="{Binding App.WatermarkOpacityPercent, Converter={StaticResource PercentToOpacity}}"
                                           Visibility="{Binding App.WatermarkEnabled, Converter={StaticResource BoolToVis}}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding App.WatermarkRotationDegrees,
                                                                 Converter={StaticResource Negate}}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- رقم الصفحة -->
                                <TextBlock Text="صفحة 1 من 12" Margin="12"
                                           FontSize="{Binding App.PageNumberFontSize}"
                                           Foreground="{Binding App.PageNumberColorHex, Converter={StaticResource HexToBrush}}"
                                           HorizontalAlignment="{Binding App.PageNumberPosition,
                                                                 Converter={StaticResource PositionToAlign}, ConverterParameter=H}"
                                           VerticalAlignment="{Binding App.PageNumberPosition,
                                                               Converter={StaticResource PositionToAlign}, ConverterParameter=V}"/>

                                <!-- النص المخصص -->
                                <TextBlock Text="{Binding App.CustomText}" Margin="12"
                                           FontSize="{Binding App.PageNumberFontSize}"
                                           Foreground="{Binding App.PageNumberColorHex, Converter={StaticResource HexToBrush}}"
                                           Visibility="{Binding App.CustomTextEnabled, Converter={StaticResource BoolToVis}}"
                                           HorizontalAlignment="{Binding App.CustomTextPosition,
                                                                 Converter={StaticResource PositionToAlign}, ConverterParameter=H}"
                                           VerticalAlignment="{Binding App.CustomTextPosition,
                                                               Converter={StaticResource PositionToAlign}, ConverterParameter=V}"/>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══════════ شريط الحالة ══════════ -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- بقى بيعدّ بجد وقت الطباعة. الشريط المتحرك (IsIndeterminate)
                 بيفضل بس وقت المعالجة، اللي مالهاش نسبة معروفة. -->
            <ProgressBar Grid.Row="0" Height="3" Margin="0,0,0,6"
                         Minimum="0" Maximum="100"
                         Value="{Binding OrderPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding ShowProgress, Converter={StaticResource InverseBool}}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="#555" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1" Text="{Binding OrderProgressText}" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>

                <!--
                    لمبة الاستقبال. موجودة عشان بلاغ حقيقي: المستخدم ظبّط
                    الاستقبال وبعدين مالقاش حاجة تقوله هو شغّال ولا لأ —
                    سطر الحالة الوحيد كان عايش في تاب الإعدادات العامة، واللي
                    في المطبعة قاعد على التاب الرئيسي طول اليوم.

                    بتبان بس لما يكون شغّال: علامة خضرا معناها "البرنامج
                    سامع"، وغيابها معناه "مش سامع". أوضح من سطر بيتقال مرة
                    في النتايج وبعدين يتلخبط وسط باقي السطور.
                -->
                <Border Grid.Column="2" Background="#E8F5E9" BorderBrush="#2FA84F" BorderThickness="1"
                        CornerRadius="3" Padding="8,2" Margin="10,0,0,0"
                        ToolTip="{Binding ReceptionStatus}"
                        Visibility="{Binding ReceptionIsRunning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="● الاستقبال شغّال" FontSize="11" Foreground="#1E7E34"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
