<Window x:Class="PrintFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintFlow" Height="600" Width="900"
        FontFamily="Segoe UI" Background="#F5F6FA">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#DCE0E8"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PrintFlow | الرئيسية" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- العمود الأول: خيارات دمج ومعالجة الملفات -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <GroupBox Header="خيارات دمج ومعالجة الملفات">
                    <StackPanel>
                        <CheckBox x:Name="PageNumbersCheckBox" Content="ترقيم صفحات كل ملف"/>
                        <CheckBox Content="دمج وحفظ الملفات" IsChecked="True" IsEnabled="False"
                                  ToolTip="مفعّلة دايمًا حاليًا - دمج الملفات هو أساس عمل البرنامج"/>
                        <CheckBox Content="حفظ الملفات المحوّلة لـ PDF" IsEnabled="False" Foreground="#999"/>
                        <CheckBox Content="حفظ الملفات بعد المعالجة" IsEnabled="False" Foreground="#999"/>
                        <CheckBox Content="ضغط الملفات (عادي)" IsEnabled="False" Foreground="#999"/>
                        <CheckBox Content="ضغط الملفات (متقدم)" IsEnabled="False" Foreground="#999"/>
                        <CheckBox Content="حذف صفحات من كل ملف" IsEnabled="False" Foreground="#999"/>
                        <TextBlock Text="قريبًا" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="العلامة المائية">
                    <StackPanel>
                        <TextBlock Text="النص (اختياري)" FontSize="11" Foreground="#666"/>
                        <TextBox x:Name="WatermarkTextBox" Margin="0,4,0,0"/>
                        <TextBlock Text="ستنتقل لتاب الإعدادات العامة لاحقًا" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- العمود الثاني: خيارات البوكليت + خيارات الطباعة -->
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <GroupBox Header="خيارات البوكليت (Booklet)">
                    <StackPanel>
                        <CheckBox Content="طباعة الملفات بنظام بوكليت" IsEnabled="False" Foreground="#999"/>
                        <TextBlock Text="قريبًا" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="خيارات الطباعة">
                    <StackPanel>
                        <TextBlock Text="مقاس الورق" FontSize="11" Foreground="#666"/>
                        <ComboBox x:Name="PaperSizeComboBox" SelectedIndex="0" Margin="0,4,0,8">
                            <ComboBoxItem Content="A4"/>
                            <ComboBoxItem Content="A3"/>
                            <ComboBoxItem Content="Letter"/>
                            <ComboBoxItem Content="Legal"/>
                        </ComboBox>

                        <CheckBox x:Name="GrayscaleCheckBox" Content="طباعة أبيض وأسود (Grayscale)"/>
                        <CheckBox x:Name="DuplexCheckBox" Content="الطباعة على الوجهين (Duplex)"/>

                        <TextBlock Text="إجمالي عدد النسخ" FontSize="11" Foreground="#666" Margin="0,8,0,0"/>
                        <TextBox x:Name="CopiesPerPrinterTextBox" Text="1" Margin="0,4,0,8"/>

                        <CheckBox x:Name="MultiPrinterCheckBox" Content="طباعة الملفات على أكثر من طابعة"
                                  Checked="MultiPrinterCheckBox_Changed" Unchecked="MultiPrinterCheckBox_Changed"/>
                        <CheckBox x:Name="DistributeCheckBox" Content="توزيع نسخ الملف الواحد على الطابعات"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- العمود الثالث: منطقة الملفات والبرنترات وأزرار التنفيذ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border x:Name="FileDropArea"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="#EEF3FF"
                            Height="110"
                            AllowDrop="True"
                            Drop="FileDropArea_Drop"
                            DragOver="FileDropArea_DragOver"
                            MouseLeftButtonUp="FileDropArea_Click">
                        <TextBlock Text="اسحب ملفات PDF هنا وأفلتها، أو اضغط لتحميل الملفات"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="10"/>
                    </Border>

                    <ListBox x:Name="LoadedFilesListBox" Height="90" Margin="0,8,0,0"/>

                    <!-- قائمة البرنترات (تظهر بس لو "طباعة على أكثر من طابعة" متفعّلة) -->
                    <StackPanel x:Name="MultiPrinterPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اختر البرنترات:" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="اكتشاف البرنترات" Padding="8,4" FontSize="11"
                                    Background="{StaticResource AccentBrush}" Style="{StaticResource ActionButton}"
                                    Click="RefreshButton_Click"/>
                        </Grid>
                        <ListBox x:Name="PrintersListBox" Height="100" Margin="0,6,0,0" SelectionMode="Multiple"/>
                    </StackPanel>
                </StackPanel>

                <!-- شريط الأزرار السفلي -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="تحميل الملفات" Background="#2FA84F" Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0" Click="FileDropArea_Click"/>
                    <Button x:Name="MergeButton" Content="بدء معالجة الملفات" Background="{StaticResource AccentBrush}"
                            Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="MergeButton_Click"/>
                    <Button x:Name="PrintToAllButton" Content="طباعة الآن" Background="#2F6FED"
                            Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="PrintToAllButton_Click"/>
                    <Button Content="حذف الملفات وإرجاع الإعدادات" Background="#E0483E"
                            Style="{StaticResource ActionButton}" Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>